# Copy this file to server/.env and fill it in.
# server/.env is gitignored. Never put real values in THIS file.

PORT=5000

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# The app has no storage of its own any more. Without this it answers 503.
#
# Atlas -> your cluster -> Connect -> Drivers -> copy the string. Replace
# <password> with the database user's password and put the database name in
# the path, e.g.  mongodb+srv://user:pass@cluster0.abcde.mongodb.net/rsyc
#
# Atlas also has to allow the connection: Network Access -> Add IP Address.
# A cloud host has no fixed IP, so there you allow 0.0.0.0/0 and rely on the
# username and password.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Sessions — CHANGE THIS BEFORE ANYONE ELSE USES THE SITE
# ---------------------------------------------------------------------------
# Signs the viewer and admin cookies. Anyone who knows it can forge a session.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Front end origin (only matters if the API sits on a different domain)
# ---------------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Where photographs may come from
# ---------------------------------------------------------------------------
# The server accepts a photo URL only if its hostname is in this list, so a
# stray or copied address cannot point the club site at someone else's server.
# Comma separated. Leave as-is if you are using Cloudinary.
IMAGE_HOSTS=res.cloudinary.com

# ---------------------------------------------------------------------------
# WhatsApp notification when someone sends a join request  (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave these empty and nothing is sent. The join form still works, and it
# still gives the visitor a "Send on WhatsApp" button that opens a chat to the
# club contact number — that route needs none of the setup below.
#
# To have the SERVER message admins by itself you need Meta's WhatsApp Cloud
# API, which means:
#   1. a Meta Business account with the business verified
#   2. a WhatsApp sender number added in Meta Business Suite
#   3. a permanent access token
#   4. an APPROVED message template — Meta does not allow a business to open a
#      conversation with free text, only with a template it has approved
# Steps 1-4 take a few days and the number cannot already be on normal
# WhatsApp. There is a per-message cost.

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Who gets told. Full international format, no +, comma separated.
# e.g. 919829011001,919829011002
WHATSAPP_NOTIFY_TO=

# Name of the approved template, and its language code. If left empty the code
# falls back to a plain text message, which Meta only delivers inside a 24 hour
# window after that person last messaged your number.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# you can switch to hn if wanted
