# Copy this file to server/.env and fill in what you need.
# Everything here has a working default, so the app runs with no .env at all.

PORT=5000

# Signs the viewer and admin session cookies. Change this before any real use.
JWT_SECRET=rsyc-dev-secret-change-me

# Leave EMPTY to run on in-memory dummy data (current setup).
# Paste your Atlas connection string here when the cluster is ready and the
# server will switch over to MongoDB on the next restart.
MONGODB_URI=

# The club PIN everyone in the village uses to see the fund.
# The master admin can change it any time from /admin/pin.
DEMO_PIN=Anirudh@1234

# Seeded accounts. Only used while there is no database.
MASTER_EMAIL=anirajput20022@gmial.com
MASTER_PASSWORD=Indian@12

ADMIN_EMAIL=tryideas2504@gmail.com
ADMIN_PASSWORD=Indian@12
